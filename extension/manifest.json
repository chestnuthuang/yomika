{
  "manifest_version": 3,
  "name": "JP → 繁中 GPT Reader",
  "version": "1.5.4",
  "description": "日文推文快速直譯，或將小說翻成繁中並保存；支援 AO3 多章、glossary、Reader、LAN 唯讀閱讀與成本統計。",
  "permissions": [
    "contextMenus",
    "storage",
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "JP → 繁中 GPT Reader"
  },
  "commands": {
    "translate-novel": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "小說模式翻譯目前反白文字"
    },
    "translate-direct": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "直譯目前反白文字"
    },
    "translate-page": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "翻譯目前頁面的小說正文"
    }
  }
}
